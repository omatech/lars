{
  "name": "omatech/lars",
  "description": "",
  "keywords": [
    "omatech",
    "lars"
  ],
  "homepage": "https://github.com/omatech/lars",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Christian Bohollo",
      "email": "cbohollo@omatech.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Omatech\\Lars\\": "src"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.5.12"
    },
    "allow-plugins": false,
    "github-protocols": [
      "https"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.6",
    "orchestra/testbench": "^11.3.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test",
      "@composer validate --no-check-publish",
      "@composer audit --locked"
    ]
  }
}
